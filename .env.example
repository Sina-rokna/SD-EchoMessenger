# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_LOG_LEVEL=INFO

# PostgreSQL
DATABASE_ENGINE=postgresql
POSTGRES_DB=echo_messenger
POSTGRES_USER=echo_messenger
POSTGRES_PASSWORD=echo_messenger
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Channels and Redis
CHANNEL_LAYER_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# Celery and RabbitMQ
RABBITMQ_DEFAULT_USER=echo_messenger
RABBITMQ_DEFAULT_PASS=echo_messenger
CELERY_BROKER_URL=amqp://echo_messenger:echo_messenger@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

# Upload and API limits
MAX_ATTACHMENT_SIZE=10485760
MAX_ATTACHMENTS_PER_MESSAGE=5
API_PAGE_SIZE=30

# Host port exposed by Nginx
APP_PORT=8080
